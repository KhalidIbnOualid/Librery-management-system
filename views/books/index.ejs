<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | Library MS</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>

<%- include('../partials/navbar') %>

<div class="container-xl py-4">
  <%- include('../partials/flash') %>

  <div class="row g-4">
    <!-- Filter Sidebar -->
    <div class="col-lg-3">
      <div class="filter-sidebar">
        <h6 class="fw-bold mb-3"><i class="bi bi-funnel me-2"></i>Filter Books</h6>
        <form method="GET" action="/books" id="filterForm">
          <!-- Search -->
          <div class="mb-3">
            <label class="form-label small fw-semibold">Search</label>
            <div class="input-group input-group-sm">
              <span class="input-group-text"><i class="bi bi-search"></i></span>
              <input type="text" name="search" class="form-control" placeholder="Title or author…"
                     value="<%= search %>" />
            </div>
          </div>

          <!-- Category -->
          <div class="mb-3">
            <label class="form-label small fw-semibold">Category</label>
            <select name="category" id="categoryFilter" class="form-select form-select-sm">
              <option value="">All Categories</option>
              <% categories.forEach(cat => { %>
                <option value="<%= cat.id %>" <%= selectedCategory == cat.id ? 'selected' : '' %>>
                  <%= cat.name %>
                </option>
              <% }) %>
            </select>
          </div>

          <!-- Subcategory -->
          <div class="mb-3">
            <label class="form-label small fw-semibold">Subcategory</label>
            <select name="subcategory" id="subcategoryFilter" class="form-select form-select-sm">
              <option value="">All Subcategories</option>
              <% allSubcategories.forEach(sub => { %>
                <option value="<%= sub.id %>"
                        data-cat-id="<%= sub.category_id %>"
                        <%= selectedSubcategory == sub.id ? 'selected' : '' %>>
                  <%= sub.name %>
                </option>
              <% }) %>
            </select>
          </div>

          <div class="d-grid gap-2">
            <button type="submit" class="btn btn-primary btn-sm">
              <i class="bi bi-funnel me-1"></i>Apply Filters
            </button>
            <a href="/books" class="btn btn-outline-secondary btn-sm">
              <i class="bi bi-x-circle me-1"></i>Clear
            </a>
          </div>
        </form>
      </div>
    </div>

    <!-- Books Grid -->
    <div class="col-lg-9">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0 section-header">
          <i class="bi bi-grid me-2"></i>
          <% if (search) { %>Results for "<%= search %>"<% } else if (selectedCategory) { %>Category Results<% } else { %>All Books<% } %>
        </h5>
        <span class="text-muted small"><%= books.length %> book<%= books.length !== 1 ? 's' : '' %> found</span>
      </div>

      <% if (books.length === 0) { %>
        <div class="alert alert-info">
          <i class="bi bi-info-circle me-2"></i>No books found matching your criteria.
          <a href="/books" class="alert-link">Clear filters</a>
        </div>
      <% } else { %>
        <div class="row g-3">
          <% books.forEach(book => { %>
          <div class="col-6 col-md-4 col-xl-3">
            <div class="card book-card shadow-sm">
              <% if (book.cover_image_path) { %>
                <img src="<%= book.cover_image_path %>" class="book-cover" alt="<%= book.title %>" />
              <% } else { %>
                <div class="book-cover-placeholder"><i class="bi bi-book"></i></div>
              <% } %>
              <div class="card-body p-3">
                <h6 class="card-title mb-1 text-truncate fw-semibold" title="<%= book.title %>"><%= book.title %></h6>
                <p class="card-text text-muted small mb-2 text-truncate"><%= book.author %></p>
                <div class="d-flex flex-wrap gap-1 mb-2">
                  <% if (book.category_name) { %>
                    <span class="badge bg-primary book-badge"><%= book.category_name %></span>
                  <% } %>
                  <% if (book.subcategory_name) { %>
                    <span class="badge bg-secondary book-badge"><%= book.subcategory_name %></span>
                  <% } %>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                  <span class="fw-semibold text-primary small">$<%= Number(book.price).toFixed(2) %></span>
                  <% if (book.stock_qty > 0) { %>
                    <span class="badge bg-success book-badge"><i class="bi bi-check-circle me-1"></i><%= book.stock_qty %> left</span>
                  <% } else { %>
                    <span class="badge bg-danger book-badge">Out of Stock</span>
                  <% } %>
                </div>
              </div>
              <div class="card-footer bg-transparent border-top-0 pt-0 pb-3 px-3">
                <a href="/books/<%= book.id %>" class="btn btn-sm btn-primary w-100">
                  <i class="bi bi-eye me-1"></i>View Details
                </a>
              </div>
            </div>
          </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>

</div>

<%- include('../partials/footer') %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body>
</html>
