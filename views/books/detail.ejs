<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | Library MS</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>

<%- include('../partials/navbar') %>

<div class="container-xl py-4">
  <%- include('../partials/flash') %>

  <nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/">Home</a></li>
      <li class="breadcrumb-item"><a href="/books">Browse Books</a></li>
      <li class="breadcrumb-item active"><%= book.title %></li>
    </ol>
  </nav>

  <div class="row g-4">
    <!-- Book Cover -->
    <div class="col-md-3 text-center">
      <% if (book.cover_image_path) { %>
        <img src="<%= book.cover_image_path %>" alt="<%= book.title %>"
             class="img-fluid rounded shadow-sm" style="max-height:320px;object-fit:cover;" />
      <% } else { %>
        <div class="rounded shadow-sm d-flex align-items-center justify-content-center bg-light"
             style="height:280px;">
          <i class="bi bi-book text-muted" style="font-size:5rem;"></i>
        </div>
      <% } %>
    </div>

    <!-- Book Details -->
    <div class="col-md-6">
      <h2 class="fw-bold mb-1"><%= book.title %></h2>
      <p class="text-muted fs-5 mb-3"><i class="bi bi-person me-1"></i><%= book.author %></p>

      <div class="d-flex flex-wrap gap-2 mb-3">
        <% if (book.category_name) { %>
          <span class="badge bg-primary fs-6"><i class="bi bi-tag me-1"></i><%= book.category_name %></span>
        <% } %>
        <% if (book.subcategory_name) { %>
          <span class="badge bg-secondary fs-6"><%= book.subcategory_name %></span>
        <% } %>
        <% if (book.isbn) { %>
          <span class="badge bg-light text-dark border fs-6">ISBN: <%= book.isbn %></span>
        <% } %>
      </div>

      <% if (book.description) { %>
        <p class="mb-3 text-muted"><%= book.description %></p>
      <% } %>

      <div class="row g-2 mb-3">
        <div class="col-auto">
          <div class="border rounded p-2 text-center" style="min-width:90px;">
            <div class="fs-4 fw-bold text-primary">$<%= Number(book.price).toFixed(2) %></div>
            <div class="small text-muted">Price</div>
          </div>
        </div>
        <div class="col-auto">
          <div class="border rounded p-2 text-center" style="min-width:90px;">
            <div class="fs-4 fw-bold <%= book.stock_qty > 0 ? 'text-success' : 'text-danger' %>">
              <%= book.stock_qty %>
            </div>
            <div class="small text-muted">In Stock</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Actions -->
    <div class="col-md-3">
      <div class="card shadow-sm border-0">
        <div class="card-body">
          <h6 class="fw-bold mb-3"><i class="bi bi-lightning me-2"></i>Quick Actions</h6>

          <% if (!user) { %>
            <div class="alert alert-warning small">
              <i class="bi bi-lock me-1"></i>
              <a href="/auth/login" class="alert-link">Login</a> to borrow or purchase this book.
            </div>
          <% } else if (user.role === 'student') { %>

            <!-- BORROW -->
            <% if (activeBorrow) { %>
              <div class="alert alert-info small mb-3">
                <i class="bi bi-info-circle me-1"></i>
                You have an active borrow request (<strong><%= activeBorrow.status %></strong>).
              </div>
            <% } else if (book.stock_qty > 0) { %>
              <form method="POST" action="/books/<%= book.id %>/borrow">
                <button type="submit" class="btn btn-success w-100 mb-2 fw-semibold"
                        onclick="return confirm('Request to borrow this book?')">
                  <i class="bi bi-arrow-left-right me-2"></i>Request Borrow
                </button>
              </form>
            <% } else { %>
              <button class="btn btn-secondary w-100 mb-2" disabled>
                <i class="bi bi-x-circle me-2"></i>Out of Stock
              </button>
            <% } %>

            <!-- PURCHASE -->
            <% if (book.stock_qty > 0) { %>
              <form method="POST" action="/books/<%= book.id %>/purchase">
                <div class="input-group input-group-sm mb-2">
                  <span class="input-group-text">Qty</span>
                  <input type="number" name="qty" value="1" min="1" max="<%= book.stock_qty %>"
                         class="form-control" />
                </div>
                <button type="submit" class="btn btn-primary w-100 fw-semibold"
                        onclick="return confirm('Confirm purchase?')">
                  <i class="bi bi-cart me-2"></i>Purchase Now
                </button>
              </form>
            <% } %>

          <% } else if (user.role === 'admin') { %>
            <a href="/admin/books/<%= book.id %>/edit" class="btn btn-warning w-100 mb-2">
              <i class="bi bi-pencil me-2"></i>Edit Book
            </a>
          <% } %>

          <hr />
          <a href="/books" class="btn btn-outline-secondary btn-sm w-100">
            <i class="bi bi-arrow-left me-1"></i>Back to Browse
          </a>
        </div>
      </div>
    </div>
  </div>

</div>

<%- include('../partials/footer') %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body>
</html>
