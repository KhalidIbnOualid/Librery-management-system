<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | Library MS</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>

<%- include('../partials/navbar') %>

<div class="container-xl py-4">
  <%- include('../partials/flash') %>

  <!-- Hero Banner -->
  <div class="hero-banner mb-5">
    <div class="row align-items-center">
      <div class="col-md-8">
        <h1 class="display-5 fw-bold mb-2"><i class="bi bi-book-half me-2"></i>Welcome to LibraryMS</h1>
        <p class="lead mb-4 opacity-75">Discover, borrow and purchase thousands of books right from your campus library.</p>
        <a href="/books" class="btn btn-light btn-lg fw-semibold me-2">
          <i class="bi bi-search me-2"></i>Browse Books
        </a>
        <% if (!user) { %>
          <a href="/auth/register" class="btn btn-outline-light btn-lg fw-semibold">
            <i class="bi bi-person-plus me-2"></i>Register Free
          </a>
        <% } %>
      </div>
      <div class="col-md-4 text-center d-none d-md-block">
        <i class="bi bi-journals" style="font-size:7rem; opacity:0.3;"></i>
      </div>
    </div>
  </div>

  <!-- Stats Row -->
  <div class="row g-3 mb-5">
    <div class="col-6 col-md-3">
      <div class="card stat-card shadow-sm h-100">
        <div class="card-body d-flex align-items-center gap-3">
          <div class="stat-icon bg-primary bg-opacity-10">
            <i class="bi bi-book text-primary"></i>
          </div>
          <div>
            <div class="fs-3 fw-bold text-primary"><%= totalBooks %></div>
            <div class="text-muted small">Total Books</div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card stat-card shadow-sm h-100">
        <div class="card-body d-flex align-items-center gap-3">
          <div class="stat-icon bg-success bg-opacity-10">
            <i class="bi bi-check-circle text-success"></i>
          </div>
          <div>
            <div class="fs-3 fw-bold text-success"><%= inStockCnt %></div>
            <div class="text-muted small">In Stock</div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card stat-card shadow-sm h-100">
        <div class="card-body d-flex align-items-center gap-3">
          <div class="stat-icon bg-danger bg-opacity-10">
            <i class="bi bi-x-circle text-danger"></i>
          </div>
          <div>
            <div class="fs-3 fw-bold text-danger"><%= stockOutCnt %></div>
            <div class="text-muted small">Stock Out</div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card stat-card shadow-sm h-100">
        <div class="card-body d-flex align-items-center gap-3">
          <div class="stat-icon bg-warning bg-opacity-10">
            <i class="bi bi-star text-warning"></i>
          </div>
          <div>
            <div class="fs-3 fw-bold text-warning"><%= newArrivals.length %></div>
            <div class="text-muted small">New Arrivals</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- New Arrivals -->
  <% if (newArrivals.length > 0) { %>
  <div class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h4 class="section-header mb-0"><i class="bi bi-stars me-2 text-warning"></i>New Arrivals</h4>
      <a href="/books" class="btn btn-sm btn-outline-primary">View All</a>
    </div>
    <div class="row g-3">
      <% newArrivals.forEach(book => { %>
      <div class="col-6 col-md-4 col-lg-3">
        <div class="card book-card shadow-sm">
          <% if (book.cover_image_path) { %>
            <img src="<%= book.cover_image_path %>" class="book-cover" alt="<%= book.title %>" />
          <% } else { %>
            <div class="book-cover-placeholder"><i class="bi bi-book"></i></div>
          <% } %>
          <div class="card-body p-3">
            <h6 class="card-title mb-1 text-truncate fw-semibold" title="<%= book.title %>"><%= book.title %></h6>
            <p class="card-text text-muted small mb-2"><%= book.author %></p>
            <div class="d-flex justify-content-between align-items-center">
              <span class="badge bg-primary book-badge"><%= book.category_name || 'Uncategorised' %></span>
              <% if (book.stock_qty > 0) { %>
                <span class="badge bg-success book-badge">In Stock</span>
              <% } else { %>
                <span class="badge bg-secondary book-badge">Out</span>
              <% } %>
            </div>
          </div>
          <div class="card-footer bg-transparent border-top-0 pt-0 pb-3 px-3">
            <a href="/books/<%= book.id %>" class="btn btn-sm btn-primary w-100">
              <i class="bi bi-eye me-1"></i>View Details
            </a>
          </div>
        </div>
      </div>
      <% }) %>
    </div>
  </div>
  <% } %>

  <!-- In Stock -->
  <% if (inStockBooks.length > 0) { %>
  <div class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h4 class="section-header mb-0"><i class="bi bi-check-circle me-2 text-success"></i>Available Now</h4>
      <a href="/books" class="btn btn-sm btn-outline-success">View All</a>
    </div>
    <div class="row g-3">
      <% inStockBooks.forEach(book => { %>
      <div class="col-6 col-md-4 col-lg-3">
        <div class="card book-card shadow-sm">
          <% if (book.cover_image_path) { %>
            <img src="<%= book.cover_image_path %>" class="book-cover" alt="<%= book.title %>" />
          <% } else { %>
            <div class="book-cover-placeholder"><i class="bi bi-book"></i></div>
          <% } %>
          <div class="card-body p-3">
            <h6 class="card-title mb-1 text-truncate fw-semibold" title="<%= book.title %>"><%= book.title %></h6>
            <p class="card-text text-muted small mb-2"><%= book.author %></p>
            <div class="d-flex justify-content-between align-items-center">
              <span class="badge bg-primary book-badge"><%= book.category_name || 'Uncategorised' %></span>
              <span class="fw-semibold text-success small">$<%= Number(book.price).toFixed(2) %></span>
            </div>
          </div>
          <div class="card-footer bg-transparent border-top-0 pt-0 pb-3 px-3">
            <a href="/books/<%= book.id %>" class="btn btn-sm btn-success w-100">
              <i class="bi bi-arrow-right me-1"></i>View
            </a>
          </div>
        </div>
      </div>
      <% }) %>
    </div>
  </div>
  <% } %>

  <!-- Stock Out -->
  <% if (stockOutBooks.length > 0) { %>
  <div class="mb-5">
    <h4 class="section-header mb-3"><i class="bi bi-x-circle me-2 text-danger"></i>Currently Unavailable</h4>
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead class="table-light">
          <tr>
            <th>Title</th>
            <th>Author</th>
            <th>Category</th>
            <th>Price</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% stockOutBooks.forEach(book => { %>
          <tr>
            <td class="fw-semibold"><%= book.title %></td>
            <td class="text-muted"><%= book.author %></td>
            <td><span class="badge bg-secondary"><%= book.category_name || '—' %></span></td>
            <td>$<%= Number(book.price).toFixed(2) %></td>
            <td><a href="/books/<%= book.id %>" class="btn btn-sm btn-outline-secondary">Details</a></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <% } %>

</div>

<%- include('../partials/footer') %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body>
</html>
