<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | Library MS</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>

<%- include('../partials/navbar') %>

<div class="container-xl py-4">
  <%- include('../partials/flash') %>

  <div class="d-flex align-items-center gap-3 mb-4">
    <div class="stat-icon bg-primary bg-opacity-10">
      <i class="bi bi-person-circle text-primary" style="font-size:2rem;"></i>
    </div>
    <div>
      <h3 class="mb-0 fw-bold">My Dashboard</h3>
      <p class="text-muted mb-0">Welcome back, <strong><%= user.name %></strong></p>
    </div>
  </div>

  <!-- Tabs -->
  <ul class="nav nav-tabs mb-4" id="dashTabs">
    <li class="nav-item">
      <a class="nav-link active" data-bs-toggle="tab" href="#borrows-tab">
        <i class="bi bi-arrow-left-right me-1"></i>My Borrows
        <span class="badge bg-primary ms-1"><%= borrows.length %></span>
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link" data-bs-toggle="tab" href="#purchases-tab">
        <i class="bi bi-cart me-1"></i>My Purchases
        <span class="badge bg-success ms-1"><%= purchases.length %></span>
      </a>
    </li>
  </ul>

  <div class="tab-content">

    <!-- Borrows Tab -->
    <div class="tab-pane fade show active" id="borrows-tab">
      <% if (borrows.length === 0) { %>
        <div class="alert alert-info">
          <i class="bi bi-info-circle me-2"></i>You have no borrow requests yet.
          <a href="/books" class="alert-link ms-1">Browse books to borrow one!</a>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead class="table-light">
              <tr>
                <th>Cover</th>
                <th>Title</th>
                <th>Author</th>
                <th>Status</th>
                <th>Requested</th>
                <th>Due Date</th>
                <th>Returned</th>
              </tr>
            </thead>
            <tbody>
              <% borrows.forEach(b => { %>
              <tr>
                <td>
                  <% if (b.cover_image_path) { %>
                    <img src="<%= b.cover_image_path %>" alt="Cover" style="width:40px;height:55px;object-fit:cover;border-radius:4px;" />
                  <% } else { %>
                    <div style="width:40px;height:55px;background:#e9ecef;border-radius:4px;display:flex;align-items:center;justify-content:center;">
                      <i class="bi bi-book text-muted"></i>
                    </div>
                  <% } %>
                </td>
                <td class="fw-semibold"><%= b.title %></td>
                <td class="text-muted small"><%= b.author %></td>
                <td>
                  <span class="badge status-<%= b.status.toLowerCase() %>"><%= b.status %></span>
                </td>
                <td class="small text-muted"><%= new Date(b.requested_at).toLocaleDateString() %></td>
                <td class="small">
                  <% if (b.due_at) { %>
                    <% const due = new Date(b.due_at); const now = new Date(); %>
                    <span class="<%= due < now && b.status !== 'Returned' ? 'text-danger fw-semibold' : '' %>">
                      <%= due.toLocaleDateString() %>
                    </span>
                  <% } else { %>
                    <span class="text-muted">—</span>
                  <% } %>
                </td>
                <td class="small text-muted">
                  <%= b.returned_at ? new Date(b.returned_at).toLocaleDateString() : '—' %>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

    <!-- Purchases Tab -->
    <div class="tab-pane fade" id="purchases-tab">
      <% if (purchases.length === 0) { %>
        <div class="alert alert-info">
          <i class="bi bi-info-circle me-2"></i>You have no purchases yet.
          <a href="/books" class="alert-link ms-1">Browse books to purchase one!</a>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead class="table-light">
              <tr>
                <th>Cover</th>
                <th>Title</th>
                <th>Author</th>
                <th>Qty</th>
                <th>Price Each</th>
                <th>Total</th>
                <th>Date</th>
              </tr>
            </thead>
            <tbody>
              <% purchases.forEach(p => { %>
              <tr>
                <td>
                  <% if (p.cover_image_path) { %>
                    <img src="<%= p.cover_image_path %>" alt="Cover" style="width:40px;height:55px;object-fit:cover;border-radius:4px;" />
                  <% } else { %>
                    <div style="width:40px;height:55px;background:#e9ecef;border-radius:4px;display:flex;align-items:center;justify-content:center;">
                      <i class="bi bi-book text-muted"></i>
                    </div>
                  <% } %>
                </td>
                <td class="fw-semibold"><%= p.title %></td>
                <td class="text-muted small"><%= p.author %></td>
                <td><%= p.qty %></td>
                <td>$<%= Number(p.price_each).toFixed(2) %></td>
                <td class="fw-semibold text-success">$<%= (p.qty * p.price_each).toFixed(2) %></td>
                <td class="small text-muted"><%= new Date(p.purchased_at).toLocaleDateString() %></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

  </div>

</div>

<%- include('../partials/footer') %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body>
</html>
