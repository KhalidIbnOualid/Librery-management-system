<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | Admin – Library MS</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="admin-layout">

<nav class="navbar navbar-dark bg-dark shadow-sm px-3">
  <a class="navbar-brand fw-bold" href="/admin/dashboard">
    <i class="bi bi-shield-lock me-2"></i>Admin Panel
  </a>
  <div class="d-flex align-items-center gap-3">
    <span class="text-white-50 small d-none d-md-block"><i class="bi bi-person me-1"></i><%= user.name %></span>
    <a href="/" class="text-white text-decoration-none small"><i class="bi bi-house me-1"></i>View Site</a>
    <a href="/auth/logout" class="btn btn-sm btn-outline-danger"><i class="bi bi-box-arrow-right me-1"></i>Logout</a>
  </div>
</nav>

<div class="d-flex" style="min-height: calc(100vh - 56px);">
  <nav class="admin-sidebar bg-dark text-white d-flex flex-column p-0" style="width:240px;min-width:240px;">
    <div class="p-3 pb-2"><p class="text-muted small mb-1 text-uppercase">Management</p></div>
    <ul class="nav flex-column px-2 gap-1">
      <li class="nav-item"><a href="/admin/dashboard" class="nav-link text-white rounded"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
      <li class="nav-item"><a href="/admin/books" class="nav-link text-white rounded active bg-primary"><i class="bi bi-book me-2"></i>Books</a></li>
      <li class="nav-item"><a href="/admin/categories" class="nav-link text-white rounded"><i class="bi bi-tag me-2"></i>Categories</a></li>
      <li class="nav-item"><a href="/admin/borrows" class="nav-link text-white rounded"><i class="bi bi-arrow-left-right me-2"></i>Borrow Requests</a></li>
      <li class="nav-item"><a href="/admin/records" class="nav-link text-white rounded"><i class="bi bi-journal-text me-2"></i>Records</a></li>
      <li class="nav-item"><a href="/admin/students" class="nav-link text-white rounded"><i class="bi bi-people me-2"></i>Students</a></li>
    </ul>
  </nav>

  <main class="flex-grow-1 p-4 bg-light overflow-auto">
    <%- include('../partials/flash') %>

    <div class="d-flex justify-content-between align-items-center mb-4">
      <h4 class="fw-bold mb-0"><i class="bi bi-book me-2"></i>Manage Books</h4>
      <a href="/admin/books/add" class="btn btn-primary">
        <i class="bi bi-plus-lg me-2"></i>Add New Book
      </a>
    </div>

    <div class="card shadow-sm border-0">
      <div class="card-body p-0">
        <% if (books.length === 0) { %>
          <p class="text-muted p-4">No books found. <a href="/admin/books/add">Add the first book.</a></p>
        <% } else { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th>Cover</th>
                  <th>Title</th>
                  <th>Author</th>
                  <th>Category</th>
                  <th>Subcategory</th>
                  <th>Stock</th>
                  <th>Price</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% books.forEach(book => { %>
                <tr>
                  <td>
                    <% if (book.cover_image_path) { %>
                      <img src="<%= book.cover_image_path %>" alt="Cover"
                           style="width:38px;height:50px;object-fit:cover;border-radius:4px;" />
                    <% } else { %>
                      <div style="width:38px;height:50px;background:#e9ecef;border-radius:4px;display:flex;align-items:center;justify-content:center;">
                        <i class="bi bi-book text-muted small"></i>
                      </div>
                    <% } %>
                  </td>
                  <td>
                    <span class="fw-semibold"><%= book.title %></span>
                    <% if (book.isbn) { %><br/><span class="text-muted" style="font-size:0.75rem;">ISBN: <%= book.isbn %></span><% } %>
                  </td>
                  <td class="text-muted small"><%= book.author %></td>
                  <td><% if (book.category_name) { %><span class="badge bg-primary"><%= book.category_name %></span><% } else { %>—<% } %></td>
                  <td><% if (book.subcategory_name) { %><span class="badge bg-secondary"><%= book.subcategory_name %></span><% } else { %>—<% } %></td>
                  <td>
                    <span class="badge <%= book.stock_qty > 0 ? 'bg-success' : 'bg-danger' %>">
                      <%= book.stock_qty %>
                    </span>
                  </td>
                  <td class="fw-semibold">$<%= Number(book.price).toFixed(2) %></td>
                  <td>
                    <a href="/admin/books/<%= book.id %>/edit" class="btn btn-sm btn-warning me-1">
                      <i class="bi bi-pencil"></i>
                    </a>
                    <form method="POST" action="/admin/books/<%= book.id %>/delete" class="d-inline"
                          onsubmit="return confirm('Delete this book?')">
                      <button type="submit" class="btn btn-sm btn-danger">
                        <i class="bi bi-trash"></i>
                      </button>
                    </form>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body>
</html>
