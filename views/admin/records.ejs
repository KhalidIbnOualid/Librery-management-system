<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | Admin – Library MS</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="admin-layout">

<nav class="navbar navbar-dark bg-dark shadow-sm px-3">
  <a class="navbar-brand fw-bold" href="/admin/dashboard"><i class="bi bi-shield-lock me-2"></i>Admin Panel</a>
  <div class="d-flex align-items-center gap-3">
    <span class="text-white-50 small d-none d-md-block"><i class="bi bi-person me-1"></i><%= user.name %></span>
    <a href="/" class="text-white text-decoration-none small"><i class="bi bi-house me-1"></i>View Site</a>
    <a href="/auth/logout" class="btn btn-sm btn-outline-danger"><i class="bi bi-box-arrow-right me-1"></i>Logout</a>
  </div>
</nav>

<div class="d-flex" style="min-height: calc(100vh - 56px);">
  <nav class="admin-sidebar bg-dark text-white d-flex flex-column p-0" style="width:240px;min-width:240px;">
    <div class="p-3 pb-2"><p class="text-muted small mb-1 text-uppercase">Management</p></div>
    <ul class="nav flex-column px-2 gap-1">
      <li class="nav-item"><a href="/admin/dashboard" class="nav-link text-white rounded"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
      <li class="nav-item"><a href="/admin/books" class="nav-link text-white rounded"><i class="bi bi-book me-2"></i>Books</a></li>
      <li class="nav-item"><a href="/admin/categories" class="nav-link text-white rounded"><i class="bi bi-tag me-2"></i>Categories</a></li>
      <li class="nav-item"><a href="/admin/borrows" class="nav-link text-white rounded"><i class="bi bi-arrow-left-right me-2"></i>Borrow Requests</a></li>
      <li class="nav-item"><a href="/admin/records" class="nav-link text-white rounded active bg-primary"><i class="bi bi-journal-text me-2"></i>Records</a></li>
      <li class="nav-item"><a href="/admin/students" class="nav-link text-white rounded"><i class="bi bi-people me-2"></i>Students</a></li>
    </ul>
  </nav>

  <main class="flex-grow-1 p-4 bg-light overflow-auto">
    <%- include('../partials/flash') %>

    <h4 class="fw-bold mb-4"><i class="bi bi-journal-text me-2"></i>Records</h4>

    <!-- Filters -->
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-body">
        <form method="GET" action="/admin/records" class="row g-3 align-items-end">
          <input type="hidden" name="tab" value="<%= activeTab %>" />
          <div class="col-md-4">
            <label class="form-label small fw-semibold">Student</label>
            <select name="student_id" class="form-select form-select-sm">
              <option value="">All Students</option>
              <% students.forEach(s => { %>
                <option value="<%= s.id %>" <%= filters.student_id == s.id ? 'selected' : '' %>>
                  <%= s.name %> (<%= s.email %>)
                </option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label small fw-semibold">From Date</label>
            <input type="date" name="from_date" class="form-control form-control-sm"
                   value="<%= filters.from_date %>" />
          </div>
          <div class="col-md-3">
            <label class="form-label small fw-semibold">To Date</label>
            <input type="date" name="to_date" class="form-control form-control-sm"
                   value="<%= filters.to_date %>" />
          </div>
          <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary btn-sm flex-grow-1">
              <i class="bi bi-funnel me-1"></i>Filter
            </button>
            <a href="/admin/records" class="btn btn-outline-secondary btn-sm">
              <i class="bi bi-x-circle"></i>
            </a>
          </div>
        </form>
      </div>
    </div>

    <!-- Tabs -->
    <ul class="nav nav-tabs mb-0" id="recordTabs">
      <li class="nav-item">
        <a class="nav-link <%= activeTab === 'borrows' ? 'active' : '' %>"
           href="/admin/records?tab=borrows&student_id=<%= filters.student_id %>&from_date=<%= filters.from_date %>&to_date=<%= filters.to_date %>">
          <i class="bi bi-arrow-left-right me-1"></i>Borrow Records
          <span class="badge bg-secondary ms-1"><%= borrows.length %></span>
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link <%= activeTab === 'purchases' ? 'active' : '' %>"
           href="/admin/records?tab=purchases&student_id=<%= filters.student_id %>&from_date=<%= filters.from_date %>&to_date=<%= filters.to_date %>">
          <i class="bi bi-cart me-1"></i>Purchase Records
          <span class="badge bg-secondary ms-1"><%= purchases.length %></span>
        </a>
      </li>
    </ul>

    <div class="card shadow-sm border-0" style="border-top-left-radius:0!important;">
      <div class="card-body p-0">

        <!-- Borrows Tab -->
        <% if (activeTab === 'borrows') { %>
          <% if (borrows.length === 0) { %>
            <p class="text-muted p-4 mb-0">No borrow records found.</p>
          <% } else { %>
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                  <tr>
                    <th>#</th>
                    <th>Student</th>
                    <th>Book</th>
                    <th>Status</th>
                    <th>Requested</th>
                    <th>Due Date</th>
                    <th>Returned</th>
                  </tr>
                </thead>
                <tbody>
                  <% borrows.forEach(b => { %>
                  <tr>
                    <td class="text-muted small">#<%= b.id %></td>
                    <td>
                      <div class="fw-semibold small"><%= b.student_name %></div>
                      <div class="text-muted" style="font-size:0.75rem;"><%= b.email %></div>
                    </td>
                    <td class="fw-semibold small"><%= b.title %></td>
                    <td><span class="badge status-<%= b.status.toLowerCase() %>"><%= b.status %></span></td>
                    <td class="small text-muted"><%= new Date(b.requested_at).toLocaleDateString() %></td>
                    <td class="small"><%= b.due_at ? new Date(b.due_at).toLocaleDateString() : '—' %></td>
                    <td class="small text-muted"><%= b.returned_at ? new Date(b.returned_at).toLocaleDateString() : '—' %></td>
                  </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>

        <!-- Purchases Tab -->
        <% } else { %>
          <% if (purchases.length === 0) { %>
            <p class="text-muted p-4 mb-0">No purchase records found.</p>
          <% } else { %>
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                  <tr>
                    <th>#</th>
                    <th>Student</th>
                    <th>Book</th>
                    <th>Qty</th>
                    <th>Price Each</th>
                    <th>Total</th>
                    <th>Date</th>
                  </tr>
                </thead>
                <tbody>
                  <% purchases.forEach(p => { %>
                  <tr>
                    <td class="text-muted small">#<%= p.id %></td>
                    <td>
                      <div class="fw-semibold small"><%= p.student_name %></div>
                      <div class="text-muted" style="font-size:0.75rem;"><%= p.email %></div>
                    </td>
                    <td class="fw-semibold small"><%= p.title %></td>
                    <td><%= p.qty %></td>
                    <td>$<%= Number(p.price_each).toFixed(2) %></td>
                    <td class="fw-semibold text-success">$<%= (p.qty * p.price_each).toFixed(2) %></td>
                    <td class="small text-muted"><%= new Date(p.purchased_at).toLocaleDateString() %></td>
                  </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        <% } %>

      </div>
    </div>
  </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body>
</html>
