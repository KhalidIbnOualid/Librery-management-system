<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | Admin – Library MS</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="admin-layout">

<nav class="navbar navbar-dark bg-dark shadow-sm px-3">
  <a class="navbar-brand fw-bold" href="/admin/dashboard"><i class="bi bi-shield-lock me-2"></i>Admin Panel</a>
  <div class="d-flex align-items-center gap-3">
    <span class="text-white-50 small d-none d-md-block"><i class="bi bi-person me-1"></i><%= user.name %></span>
    <a href="/" class="text-white text-decoration-none small"><i class="bi bi-house me-1"></i>View Site</a>
    <a href="/auth/logout" class="btn btn-sm btn-outline-danger"><i class="bi bi-box-arrow-right me-1"></i>Logout</a>
  </div>
</nav>

<div class="d-flex" style="min-height: calc(100vh - 56px);">
  <nav class="admin-sidebar bg-dark text-white d-flex flex-column p-0" style="width:240px;min-width:240px;">
    <div class="p-3 pb-2"><p class="text-muted small mb-1 text-uppercase">Management</p></div>
    <ul class="nav flex-column px-2 gap-1">
      <li class="nav-item"><a href="/admin/dashboard" class="nav-link text-white rounded"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
      <li class="nav-item"><a href="/admin/books" class="nav-link text-white rounded"><i class="bi bi-book me-2"></i>Books</a></li>
      <li class="nav-item"><a href="/admin/categories" class="nav-link text-white rounded active bg-primary"><i class="bi bi-tag me-2"></i>Categories</a></li>
      <li class="nav-item"><a href="/admin/borrows" class="nav-link text-white rounded"><i class="bi bi-arrow-left-right me-2"></i>Borrow Requests</a></li>
      <li class="nav-item"><a href="/admin/records" class="nav-link text-white rounded"><i class="bi bi-journal-text me-2"></i>Records</a></li>
      <li class="nav-item"><a href="/admin/students" class="nav-link text-white rounded"><i class="bi bi-people me-2"></i>Students</a></li>
    </ul>
  </nav>

  <main class="flex-grow-1 p-4 bg-light overflow-auto">
    <%- include('../partials/flash') %>

    <h4 class="fw-bold mb-4"><i class="bi bi-tag me-2"></i>Manage Categories</h4>

    <div class="row g-4">
      <!-- Categories -->
      <div class="col-md-5">
        <div class="card shadow-sm border-0 mb-4">
          <div class="card-header bg-white border-bottom">
            <h6 class="fw-bold mb-0">Categories</h6>
          </div>
          <div class="card-body">
            <form method="POST" action="/admin/categories/add" class="d-flex gap-2 mb-3">
              <input type="text" name="name" class="form-control form-control-sm"
                     placeholder="New category name" required />
              <button type="submit" class="btn btn-sm btn-primary text-nowrap">
                <i class="bi bi-plus-lg me-1"></i>Add
              </button>
            </form>
            <% if (categories.length === 0) { %>
              <p class="text-muted small mb-0">No categories yet.</p>
            <% } else { %>
              <ul class="list-group list-group-flush">
                <% categories.forEach(cat => { %>
                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                  <span class="fw-semibold small"><%= cat.name %></span>
                  <form method="POST" action="/admin/categories/<%= cat.id %>/delete"
                        onsubmit="return confirm('Delete this category? Subcategories will also be removed.')">
                    <button type="submit" class="btn btn-sm btn-outline-danger py-0">
                      <i class="bi bi-trash"></i>
                    </button>
                  </form>
                </li>
                <% }) %>
              </ul>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Subcategories -->
      <div class="col-md-7">
        <div class="card shadow-sm border-0">
          <div class="card-header bg-white border-bottom">
            <h6 class="fw-bold mb-0">Subcategories</h6>
          </div>
          <div class="card-body">
            <form method="POST" action="/admin/subcategories/add" class="row g-2 mb-3">
              <div class="col-5">
                <select name="category_id" class="form-select form-select-sm" required>
                  <option value="">Select Category</option>
                  <% categories.forEach(cat => { %>
                    <option value="<%= cat.id %>"><%= cat.name %></option>
                  <% }) %>
                </select>
              </div>
              <div class="col-5">
                <input type="text" name="name" class="form-control form-control-sm"
                       placeholder="Subcategory name" required />
              </div>
              <div class="col-2">
                <button type="submit" class="btn btn-sm btn-primary w-100">
                  <i class="bi bi-plus-lg"></i>
                </button>
              </div>
            </form>

            <% if (subcategories.length === 0) { %>
              <p class="text-muted small mb-0">No subcategories yet.</p>
            <% } else { %>
              <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                  <thead class="table-light">
                    <tr>
                      <th>Name</th>
                      <th>Category</th>
                      <th></th>
                    </tr>
                  </thead>
                  <tbody>
                    <% subcategories.forEach(sub => { %>
                    <tr>
                      <td class="small fw-semibold"><%= sub.name %></td>
                      <td><span class="badge bg-primary small"><%= sub.category_name %></span></td>
                      <td>
                        <form method="POST" action="/admin/subcategories/<%= sub.id %>/delete"
                              onsubmit="return confirm('Delete this subcategory?')">
                          <button type="submit" class="btn btn-sm btn-outline-danger py-0">
                            <i class="bi bi-trash"></i>
                          </button>
                        </form>
                      </td>
                    </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body>
</html>
