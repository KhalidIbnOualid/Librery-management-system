<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | Admin – Library MS</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="admin-layout">

<nav class="navbar navbar-dark bg-dark shadow-sm px-3">
  <a class="navbar-brand fw-bold" href="/admin/dashboard"><i class="bi bi-shield-lock me-2"></i>Admin Panel</a>
  <div class="d-flex align-items-center gap-3">
    <span class="text-white-50 small d-none d-md-block"><i class="bi bi-person me-1"></i><%= user.name %></span>
    <a href="/" class="text-white text-decoration-none small"><i class="bi bi-house me-1"></i>View Site</a>
    <a href="/auth/logout" class="btn btn-sm btn-outline-danger"><i class="bi bi-box-arrow-right me-1"></i>Logout</a>
  </div>
</nav>

<div class="d-flex" style="min-height: calc(100vh - 56px);">
  <nav class="admin-sidebar bg-dark text-white d-flex flex-column p-0" style="width:240px;min-width:240px;">
    <div class="p-3 pb-2"><p class="text-muted small mb-1 text-uppercase">Management</p></div>
    <ul class="nav flex-column px-2 gap-1">
      <li class="nav-item"><a href="/admin/dashboard" class="nav-link text-white rounded"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
      <li class="nav-item"><a href="/admin/books" class="nav-link text-white rounded"><i class="bi bi-book me-2"></i>Books</a></li>
      <li class="nav-item"><a href="/admin/categories" class="nav-link text-white rounded"><i class="bi bi-tag me-2"></i>Categories</a></li>
      <li class="nav-item"><a href="/admin/borrows" class="nav-link text-white rounded active bg-primary"><i class="bi bi-arrow-left-right me-2"></i>Borrow Requests</a></li>
      <li class="nav-item"><a href="/admin/records" class="nav-link text-white rounded"><i class="bi bi-journal-text me-2"></i>Records</a></li>
      <li class="nav-item"><a href="/admin/students" class="nav-link text-white rounded"><i class="bi bi-people me-2"></i>Students</a></li>
    </ul>
  </nav>

  <main class="flex-grow-1 p-4 bg-light overflow-auto">
    <%- include('../partials/flash') %>

    <div class="d-flex justify-content-between align-items-center mb-4">
      <h4 class="fw-bold mb-0"><i class="bi bi-arrow-left-right me-2"></i>Borrow Requests</h4>
      <!-- Status filter -->
      <div class="d-flex gap-2 align-items-center">
        <span class="text-muted small">Filter:</span>
        <a href="/admin/borrows" class="btn btn-sm <%= !filterStatus ? 'btn-dark' : 'btn-outline-secondary' %>">All</a>
        <a href="/admin/borrows?status=Pending" class="btn btn-sm <%= filterStatus === 'Pending' ? 'btn-warning' : 'btn-outline-warning' %>">Pending</a>
        <a href="/admin/borrows?status=Approved" class="btn btn-sm <%= filterStatus === 'Approved' ? 'btn-primary' : 'btn-outline-primary' %>">Approved</a>
        <a href="/admin/borrows?status=Borrowed" class="btn btn-sm <%= filterStatus === 'Borrowed' ? 'btn-success' : 'btn-outline-success' %>">Borrowed</a>
        <a href="/admin/borrows?status=Returned" class="btn btn-sm <%= filterStatus === 'Returned' ? 'btn-secondary' : 'btn-outline-secondary' %>">Returned</a>
        <a href="/admin/borrows?status=Declined" class="btn btn-sm <%= filterStatus === 'Declined' ? 'btn-danger' : 'btn-outline-danger' %>">Declined</a>
      </div>
    </div>

    <div class="card shadow-sm border-0">
      <div class="card-body p-0">
        <% if (borrows.length === 0) { %>
          <p class="text-muted p-4 mb-0">No borrow requests found.</p>
        <% } else { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th>#</th>
                  <th>Student</th>
                  <th>Book</th>
                  <th>Status</th>
                  <th>Requested</th>
                  <th>Due Date</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% borrows.forEach(b => { %>
                <tr>
                  <td class="text-muted small">#<%= b.id %></td>
                  <td>
                    <div class="fw-semibold small"><%= b.student_name %></div>
                    <div class="text-muted" style="font-size:0.75rem;"><%= b.student_email %></div>
                  </td>
                  <td class="fw-semibold small"><%= b.title %></td>
                  <td>
                    <span class="badge status-<%= b.status.toLowerCase() %>"><%= b.status %></span>
                  </td>
                  <td class="small text-muted"><%= new Date(b.requested_at).toLocaleDateString() %></td>
                  <td class="small">
                    <% if (b.due_at) { %>
                      <% const due = new Date(b.due_at); const now = new Date(); %>
                      <span class="<%= due < now && b.status !== 'Returned' ? 'text-danger fw-semibold' : '' %>">
                        <%= due.toLocaleDateString() %>
                      </span>
                    <% } else { %>—<% } %>
                  </td>
                  <td>
                    <form method="POST" action="/admin/borrows/<%= b.id %>/action" class="d-flex flex-wrap gap-1">
                      <% if (b.status === 'Pending') { %>
                        <button name="action" value="approve" class="btn btn-sm btn-primary"
                                onclick="return confirm('Approve this request?')">
                          <i class="bi bi-check-lg me-1"></i>Approve
                        </button>
                        <button name="action" value="decline" class="btn btn-sm btn-danger"
                                onclick="return confirm('Decline this request?')">
                          <i class="bi bi-x-lg me-1"></i>Decline
                        </button>
                      <% } else if (b.status === 'Approved') { %>
                        <button name="action" value="mark_borrowed" class="btn btn-sm btn-success">
                          <i class="bi bi-book me-1"></i>Mark Borrowed
                        </button>
                      <% } else if (b.status === 'Borrowed') { %>
                        <button name="action" value="return" class="btn btn-sm btn-secondary"
                                onclick="return confirm('Mark as returned?')">
                          <i class="bi bi-arrow-return-left me-1"></i>Return
                        </button>
                      <% } else { %>
                        <span class="text-muted small">—</span>
                      <% } %>
                    </form>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body>
</html>
