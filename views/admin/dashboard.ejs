<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | Admin – Library MS</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="admin-layout">

<!-- Top Navbar -->
<nav class="navbar navbar-dark bg-dark shadow-sm px-3">
  <a class="navbar-brand fw-bold" href="/admin/dashboard">
    <i class="bi bi-shield-lock me-2"></i>Admin Panel
  </a>
  <div class="d-flex align-items-center gap-3">
    <span class="text-white-50 small d-none d-md-block"><i class="bi bi-person me-1"></i><%= user.name %></span>
    <a href="/" class="text-white text-decoration-none small"><i class="bi bi-house me-1"></i>View Site</a>
    <a href="/auth/logout" class="btn btn-sm btn-outline-danger"><i class="bi bi-box-arrow-right me-1"></i>Logout</a>
  </div>
</nav>

<div class="d-flex" style="min-height: calc(100vh - 56px);">
  <!-- Sidebar -->
  <nav class="admin-sidebar bg-dark text-white d-flex flex-column p-0" style="width:240px;min-width:240px;">
    <div class="p-3 pb-2">
      <p class="text-muted small mb-1 text-uppercase">Management</p>
    </div>
    <ul class="nav flex-column px-2 gap-1">
      <li class="nav-item">
        <a href="/admin/dashboard" class="nav-link text-white rounded <%= title === 'Admin Dashboard' ? 'active bg-primary' : '' %>">
          <i class="bi bi-speedometer2 me-2"></i>Dashboard
        </a>
      </li>
      <li class="nav-item">
        <a href="/admin/books" class="nav-link text-white rounded <%= title.includes('Book') ? 'active bg-primary' : '' %>">
          <i class="bi bi-book me-2"></i>Books
        </a>
      </li>
      <li class="nav-item">
        <a href="/admin/categories" class="nav-link text-white rounded <%= title === 'Manage Categories' ? 'active bg-primary' : '' %>">
          <i class="bi bi-tag me-2"></i>Categories
        </a>
      </li>
      <li class="nav-item">
        <a href="/admin/borrows" class="nav-link text-white rounded <%= title === 'Borrow Requests' ? 'active bg-primary' : '' %>">
          <i class="bi bi-arrow-left-right me-2"></i>Borrow Requests
        </a>
      </li>
      <li class="nav-item">
        <a href="/admin/records" class="nav-link text-white rounded <%= title === 'Records' ? 'active bg-primary' : '' %>">
          <i class="bi bi-journal-text me-2"></i>Records
        </a>
      </li>
      <li class="nav-item">
        <a href="/admin/students" class="nav-link text-white rounded <%= title === 'Manage Students' ? 'active bg-primary' : '' %>">
          <i class="bi bi-people me-2"></i>Students
        </a>
      </li>
    </ul>
  </nav>

  <!-- Main Content -->
  <main class="flex-grow-1 p-4 bg-light overflow-auto">
    <%- include('../partials/flash') %>

    <!-- Summary Cards -->
    <h4 class="fw-bold mb-4"><i class="bi bi-speedometer2 me-2"></i>Dashboard Overview</h4>

    <div class="row g-3 mb-4">
      <div class="col-6 col-xl-3">
        <div class="card stat-card shadow-sm border-0 h-100">
          <div class="card-body d-flex align-items-center gap-3">
            <div class="stat-icon bg-primary bg-opacity-10">
              <i class="bi bi-people text-primary"></i>
            </div>
            <div>
              <div class="fs-2 fw-bold text-primary"><%= total_students %></div>
              <div class="text-muted small">Total Students</div>
            </div>
          </div>
          <div class="card-footer bg-transparent border-top-0 pt-0 pb-2 px-3">
            <a href="/admin/students" class="small text-primary text-decoration-none">View Students →</a>
          </div>
        </div>
      </div>
      <div class="col-6 col-xl-3">
        <div class="card stat-card shadow-sm border-0 h-100">
          <div class="card-body d-flex align-items-center gap-3">
            <div class="stat-icon bg-success bg-opacity-10">
              <i class="bi bi-book text-success"></i>
            </div>
            <div>
              <div class="fs-2 fw-bold text-success"><%= total_books %></div>
              <div class="text-muted small">Total Books</div>
            </div>
          </div>
          <div class="card-footer bg-transparent border-top-0 pt-0 pb-2 px-3">
            <a href="/admin/books" class="small text-success text-decoration-none">Manage Books →</a>
          </div>
        </div>
      </div>
      <div class="col-6 col-xl-3">
        <div class="card stat-card shadow-sm border-0 h-100">
          <div class="card-body d-flex align-items-center gap-3">
            <div class="stat-icon bg-danger bg-opacity-10">
              <i class="bi bi-x-circle text-danger"></i>
            </div>
            <div>
              <div class="fs-2 fw-bold text-danger"><%= stock_out %></div>
              <div class="text-muted small">Stock Out</div>
            </div>
          </div>
          <div class="card-footer bg-transparent border-top-0 pt-0 pb-2 px-3">
            <a href="/admin/books" class="small text-danger text-decoration-none">View Books →</a>
          </div>
        </div>
      </div>
      <div class="col-6 col-xl-3">
        <div class="card stat-card shadow-sm border-0 h-100">
          <div class="card-body d-flex align-items-center gap-3">
            <div class="stat-icon bg-warning bg-opacity-10">
              <i class="bi bi-clock text-warning"></i>
            </div>
            <div>
              <div class="fs-2 fw-bold text-warning"><%= pending_borrows %></div>
              <div class="text-muted small">Pending Borrows</div>
            </div>
          </div>
          <div class="card-footer bg-transparent border-top-0 pt-0 pb-2 px-3">
            <a href="/admin/borrows?status=Pending" class="small text-warning text-decoration-none">View Requests →</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Recent Activity -->
    <div class="row g-4">
      <!-- Recent Borrows -->
      <div class="col-lg-6">
        <div class="card shadow-sm border-0">
          <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold"><i class="bi bi-arrow-left-right me-2 text-primary"></i>Recent Borrow Requests</h6>
            <a href="/admin/borrows" class="btn btn-sm btn-outline-primary">View All</a>
          </div>
          <div class="card-body p-0">
            <% if (recentBorrows.length === 0) { %>
              <p class="text-muted p-3 mb-0">No borrow requests yet.</p>
            <% } else { %>
              <ul class="list-group list-group-flush">
                <% recentBorrows.forEach(b => { %>
                <li class="list-group-item d-flex justify-content-between align-items-center">
                  <div>
                    <div class="fw-semibold small"><%= b.title %></div>
                    <div class="text-muted" style="font-size:0.78rem;"><%= b.student_name %> • <%= new Date(b.requested_at).toLocaleDateString() %></div>
                  </div>
                  <span class="badge status-<%= b.status.toLowerCase() %>"><%= b.status %></span>
                </li>
                <% }) %>
              </ul>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Recent Purchases -->
      <div class="col-lg-6">
        <div class="card shadow-sm border-0">
          <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold"><i class="bi bi-cart me-2 text-success"></i>Recent Purchases</h6>
            <a href="/admin/records?tab=purchases" class="btn btn-sm btn-outline-success">View All</a>
          </div>
          <div class="card-body p-0">
            <% if (recentPurchases.length === 0) { %>
              <p class="text-muted p-3 mb-0">No purchases yet.</p>
            <% } else { %>
              <ul class="list-group list-group-flush">
                <% recentPurchases.forEach(p => { %>
                <li class="list-group-item d-flex justify-content-between align-items-center">
                  <div>
                    <div class="fw-semibold small"><%= p.title %></div>
                    <div class="text-muted" style="font-size:0.78rem;"><%= p.student_name %> • <%= new Date(p.purchased_at).toLocaleDateString() %></div>
                  </div>
                  <span class="badge bg-success">$<%= (p.qty * p.price_each).toFixed(2) %></span>
                </li>
                <% }) %>
              </ul>
            <% } %>
          </div>
        </div>
      </div>
    </div>

  </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body>
</html>
