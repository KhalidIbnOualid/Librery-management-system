<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | Admin – Library MS</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="admin-layout">

<nav class="navbar navbar-dark bg-dark shadow-sm px-3">
  <a class="navbar-brand fw-bold" href="/admin/dashboard"><i class="bi bi-shield-lock me-2"></i>Admin Panel</a>
  <div class="d-flex align-items-center gap-3">
    <span class="text-white-50 small d-none d-md-block"><i class="bi bi-person me-1"></i><%= user.name %></span>
    <a href="/" class="text-white text-decoration-none small"><i class="bi bi-house me-1"></i>View Site</a>
    <a href="/auth/logout" class="btn btn-sm btn-outline-danger"><i class="bi bi-box-arrow-right me-1"></i>Logout</a>
  </div>
</nav>

<div class="d-flex" style="min-height: calc(100vh - 56px);">
  <nav class="admin-sidebar bg-dark text-white d-flex flex-column p-0" style="width:240px;min-width:240px;">
    <div class="p-3 pb-2"><p class="text-muted small mb-1 text-uppercase">Management</p></div>
    <ul class="nav flex-column px-2 gap-1">
      <li class="nav-item"><a href="/admin/dashboard" class="nav-link text-white rounded"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
      <li class="nav-item"><a href="/admin/books" class="nav-link text-white rounded active bg-primary"><i class="bi bi-book me-2"></i>Books</a></li>
      <li class="nav-item"><a href="/admin/categories" class="nav-link text-white rounded"><i class="bi bi-tag me-2"></i>Categories</a></li>
      <li class="nav-item"><a href="/admin/borrows" class="nav-link text-white rounded"><i class="bi bi-arrow-left-right me-2"></i>Borrow Requests</a></li>
      <li class="nav-item"><a href="/admin/records" class="nav-link text-white rounded"><i class="bi bi-journal-text me-2"></i>Records</a></li>
      <li class="nav-item"><a href="/admin/students" class="nav-link text-white rounded"><i class="bi bi-people me-2"></i>Students</a></li>
    </ul>
  </nav>

  <main class="flex-grow-1 p-4 bg-light overflow-auto">
    <%- include('../partials/flash') %>

    <div class="d-flex align-items-center gap-2 mb-4">
      <a href="/admin/books" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i></a>
      <h4 class="fw-bold mb-0"><i class="bi bi-<%= book ? 'pencil' : 'plus-lg' %> me-2"></i><%= title %></h4>
    </div>

    <div class="card shadow-sm border-0" style="max-width:720px;">
      <div class="card-body p-4">
        <form method="POST"
              action="<%= book ? `/admin/books/${book.id}/edit` : '/admin/books/add' %>"
              enctype="multipart/form-data"
              novalidate>

          <div class="row g-3">
            <!-- Title -->
            <div class="col-md-8">
              <label class="form-label fw-semibold">Title <span class="text-danger">*</span></label>
              <input type="text" name="title" class="form-control" required
                     value="<%= book ? book.title : '' %>" placeholder="Book title" />
            </div>

            <!-- ISBN -->
            <div class="col-md-4">
              <label class="form-label fw-semibold">ISBN</label>
              <input type="text" name="isbn" class="form-control"
                     value="<%= book ? (book.isbn || '') : '' %>" placeholder="Optional" />
            </div>

            <!-- Author -->
            <div class="col-md-6">
              <label class="form-label fw-semibold">Author <span class="text-danger">*</span></label>
              <input type="text" name="author" class="form-control" required
                     value="<%= book ? book.author : '' %>" placeholder="Author name" />
            </div>

            <!-- Price -->
            <div class="col-md-3">
              <label class="form-label fw-semibold">Price ($) <span class="text-danger">*</span></label>
              <input type="number" name="price" class="form-control" required min="0" step="0.01"
                     value="<%= book ? Number(book.price).toFixed(2) : '0.00' %>" />
            </div>

            <!-- Stock Qty -->
            <div class="col-md-3">
              <label class="form-label fw-semibold">Stock Qty <span class="text-danger">*</span></label>
              <input type="number" name="stock_qty" class="form-control" required min="0"
                     value="<%= book ? book.stock_qty : '0' %>" />
            </div>

            <!-- Category -->
            <div class="col-md-6">
              <label class="form-label fw-semibold">Category</label>
              <select name="category_id" class="form-select" id="adminCategoryFilter">
                <option value="">— None —</option>
                <% categories.forEach(cat => { %>
                  <option value="<%= cat.id %>"
                    <%= book && book.category_id == cat.id ? 'selected' : '' %>>
                    <%= cat.name %>
                  </option>
                <% }) %>
              </select>
            </div>

            <!-- Subcategory -->
            <div class="col-md-6">
              <label class="form-label fw-semibold">Subcategory</label>
              <select name="subcategory_id" class="form-select" id="adminSubcategoryFilter">
                <option value="">— None —</option>
                <% subcategories.forEach(sub => { %>
                  <option value="<%= sub.id %>"
                          data-cat-id="<%= sub.category_id %>"
                    <%= book && book.subcategory_id == sub.id ? 'selected' : '' %>>
                    <%= sub.name %>
                  </option>
                <% }) %>
              </select>
            </div>

            <!-- Description -->
            <div class="col-12">
              <label class="form-label fw-semibold">Description</label>
              <textarea name="description" class="form-control" rows="4"
                        placeholder="Optional book description…"><%= book ? (book.description || '') : '' %></textarea>
            </div>

            <!-- Cover Image -->
            <div class="col-12">
              <label class="form-label fw-semibold">Cover Image</label>
              <input type="file" name="cover_image" class="form-control" accept="image/*" />
              <% if (book && book.cover_image_path) { %>
                <div class="mt-2 d-flex align-items-center gap-2">
                  <img src="<%= book.cover_image_path %>" alt="Current Cover"
                       style="height:60px;object-fit:cover;border-radius:4px;" />
                  <span class="text-muted small">Current cover (upload new to replace)</span>
                </div>
              <% } %>
            </div>
          </div>

          <hr class="my-4" />

          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary fw-semibold">
              <i class="bi bi-save me-2"></i><%= book ? 'Save Changes' : 'Add Book' %>
            </button>
            <a href="/admin/books" class="btn btn-outline-secondary">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
// Subcategory filter for admin book form
(function() {
  const catSel = document.getElementById('adminCategoryFilter');
  const subSel = document.getElementById('adminSubcategoryFilter');
  if (!catSel || !subSel) return;
  const allOpts = Array.from(subSel.options);

  function filter() {
    const catId = catSel.value;
    const current = subSel.value;
    subSel.innerHTML = '<option value="">— None —</option>';
    allOpts.forEach(opt => {
      if (!opt.value) return;
      if (!catId || opt.dataset.catId === catId) {
        subSel.appendChild(opt.cloneNode(true));
      }
    });
    subSel.value = current;
  }

  catSel.addEventListener('change', () => { filter(); subSel.value = ''; });
  filter();
})();
</script>
</body>
</html>
